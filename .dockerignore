# e2e/ and tests/ are deliberately NOT listed here. tsconfig.json type-checks
# `**/*.ts`, and scripts/ imports from both — playwright.config.ts and
# scripts/e2e-clean.ts from e2e/, scripts/drop-test-db.ts from
# tests/helpers/test-db-url.ts. Ignoring either makes `next build` fail inside
# the image with TS2307 while CI, which builds the full checkout, stays green.
# They reach the build stage only; the runner stage copies neither.
