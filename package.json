{
  "name": "authgd",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/db/migrate.ts",
    "smoke:wanderer": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/wanderer-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "jose": "^6.0.0",
    "next": "^15.4.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.22",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^2.7.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.0.0"
  }
}
