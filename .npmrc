# Fail `npm install` on an unsupported Node instead of producing a clone that
# breaks later at an unrelated-looking command. Stage 2 puts Node 22.9+'s
# --env-file-if-exists on `npm run worker` and `npm run db:migrate` — the
# latter is Fly's release_command, so a Node below 22.9 fails every deploy
# with `node: bad option`. See docs/superpowers/specs/2026-08-03-local-dev-setup.md (D7a).
engine-strict=true
